# App
APP_NAME=KrishiSutraAI
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=super-secret-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MongoDB
MONGO_URI=mongodb://mongo:27017/krishisutra
MONGO_DB_NAME=krishisutra

# PostgreSQL (optional analytics)
POSTGRES_URI=postgresql+asyncpg://krishi:krishi@postgres:5432/krishisutra_analytics

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3

# Vector DB
FAISS_INDEX_PATH=./data/faiss_index

CHROMA_PATH=./data/chroma

# Scraping
SCRAPE_INTERVAL_HOURS=6
USER_AGENT=Mozilla/5.0 (compatible; KrishiSutra/1.0)

# Celery/APScheduler
ENABLE_SCHEDULER=true
